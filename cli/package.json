{
  "name": "payflow-cli",
  "version": "1.0.0",
  "description": "Developer CLI to manage PayFlow Protocol streams and escrows from the command line",
  "type": "module",
  "bin": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@payflow/sdk": "workspace:*",
    "@stellar/stellar-sdk": "^11.3.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsup": "^8.0.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
